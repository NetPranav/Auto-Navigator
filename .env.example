# =======================================================
# Auto-Navigator Configuration
# =======================================================

# NVIDIA NIM API Settings
# Get your API key from: https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Models
# Vision model options: meta/llama-3.2-90b-vision-instruct, meta/llama-3.2-11b-vision-instruct, etc.
DEFAULT_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
# Reasoning / Text model options: meta/llama-3.3-70b-instruct, meta/llama-3.1-70b-instruct, etc.
DEFAULT_REASONING_MODEL=meta/llama-3.2-11b-vision-instruct

# Execution Mode: "desktop" (live visual macOS desktop control) or "headless"
DEFAULT_EXECUTION_MODE=desktop

# Browser Profile (to keep sessions logged into LinkedIn/GitHub/etc.)
BROWSER_PROFILE_PATH=./browser_profile

# Screenshots & Debug
SAVE_DEBUG_SCREENSHOTS=true
SCREENSHOTS_DIR=./screenshots

# HITL (Human In The Loop) settings
# "native" (macOS popup modal) or "cli" (terminal prompt)
HITL_INTERFACE=cli
